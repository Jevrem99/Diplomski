# Kopiraj u .env i popuni (fajl .env se NE komituje)

# --- Baza ---
DATABASE_URL=postgresql://postgres:lozinka@localhost:5432/diplomski

# --- Server ---
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:4200
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# --- Autentifikacija (OBAVEZNO) ---
# Generiši: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h

# --- Admin koji se pravi pri prvom pokretanju ako admina nema (npm run seed) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pmf.kg.ac.rs
# Ako se izostavi: u razvoju "admin123", u produkciji nasumična lozinka ispisana u konzoli
ADMIN_PASSWORD=

# --- Mejl (reset lozinke i obaveštenja o dežurstvima) ---
EMAIL_USER=
EMAIL_PASS=

# --- Automatska sinhronizacija redovne nastave sa IMI sajta ---
# Svake noći u zadati sat (0-23, po vremenu servera); isključi sa NOCNI_SYNC=false
NOCNI_SYNC=true
NOCNI_SYNC_SAT=3

# --- Opciono ---
# Dozvoli vezu sa IMI sajtom bez provere sertifikata (inače samo ako sertifikat nije validan)
IMI_INSECURE_TLS=false
