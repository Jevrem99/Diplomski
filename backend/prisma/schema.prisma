generator client {
provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Mapiranje tabela iz starog SQL-a u Prisma modele (klase)

model User {
id       Int    @id @default(autoincrement())
username String @unique
email    String @unique
password String
uloga    String @default("asistent")
}

model Profesor {
id          Int         @id @default(autoincrement())
ime         String
prezime     String
is_saradnik Boolean
email       String?
predmeti    Predmet[]   // Relacija: Profesor drži više predmeta
dezurstva   Dezurstva[] // Relacija: Profesor/asistent dežura na više ispita
}

model Predmet {
  id          Int       @id @default(autoincrement())
  sifra       String    @unique
  naziv       String
  godina      Int
  semestar    String
  status      String
  profesor_id Int?
  profesor    Profesor? @relation(fields: [profesor_id], references: [id])
  ispiti      Ispit[]
}
model Sala {
  id        Int      @id @default(autoincrement())
  naziv     String   @unique
  kapacitet Int?     
  ispiti    Ispit[]
}
model Ispit {
  id         Int         @id @default(autoincrement())
  predmet_id Int?
  datum      DateTime
  vreme      DateTime
  sala_id    Int?
  
  is_ispit   Boolean     @default(true)
  
  predmet    Predmet?    @relation(fields: [predmet_id], references: [id])
  
  sala       Sala?       @relation(fields: [sala_id], references: [id])
  
  dezurstva  Dezurstva[] 
}

model Dezurstva {
id          Int       @id @default(autoincrement())
ispit_id    Int?
ispit       Ispit?    @relation(fields: [ispit_id], references: [id])
saradnik_id Int?
saradnik    Profesor? @relation(fields: [saradnik_id], references: [id])
}
