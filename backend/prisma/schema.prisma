generator client {
provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Mapiranje tabela iz starog SQL-a u Prisma modele (klase)

model User {
id       Int    @id @default(autoincrement())
username String @unique
email    String @unique
password String
uloga    String @default("asistent")
}

model Profesor {
  id          Int         @id @default(autoincrement())
  ime         String
  prezime     String
  is_saradnik Boolean     @default(false)
  email       String?
  
  // Relacija kada je on GLAVNI profesor na predmetu
  predmeti    Predmet[]   @relation("GlavniProfesor")
  
  // Relacija kada je on SARADNIK (asistent) na predmetima
  angazovanja Predmet[]   @relation("AngazovaniSaradnici")
  
  dezurstva   Dezurstva[]
  obaveze     Obaveza[]
}

model Predmet {
  id          Int      @id @default(autoincrement())
  sifra       String   @unique
  naziv       String
  godina      Int
  semestar    String
  status         String     // O ili I
  broj_studenata Int        @default(0) // <--- DODATO
  
  // Glavni profesor
  profesor_id Int?
  profesor    Profesor?  @relation("GlavniProfesor", fields: [profesor_id], references: [id])
  
  // Lista saradnika (asistenata) koji drže vežbe na ovom predmetu
  saradnici   Profesor[] @relation("AngazovaniSaradnici")
  
  ispiti      Ispit[]
}
model Sala {
  id        Int      @id @default(autoincrement())
  naziv     String   @unique
  kapacitet Int?     
  ispiti    Ispit[]
  redovnaNastava RedovnaNastava[]
}
model Ispit {
  id         Int         @id @default(autoincrement())
  predmet_id Int?
  datum      DateTime
  vreme       DateTime  @db.Time(6)
  vreme_kraja DateTime? @db.Time(6)
  sala_id    Int?
  
  is_ispit   Boolean     @default(true)
  is_izmenjen  Boolean     @default(false)
  predmet    Predmet?    @relation(fields: [predmet_id], references: [id])
  is_published Boolean    @default(false)
  sala       Sala?       @relation(fields: [sala_id], references: [id])
  
  dezurstva  Dezurstva[] 
}
model RedovnaNastava {
  id             Int      @id @default(autoincrement())
  sala_id        Int
  sala           Sala     @relation(fields: [sala_id], references: [id])
  datum          DateTime // <--- Tačan datum nastave iz IMI kalendara!
  vreme_pocetka  String
  vreme_kraja    String
  predmet        String
  nastavnik      String?
}
model Obaveza {
  id            Int       @id @default(autoincrement())
  saradnik_id   Int
  dan_u_nedelji Int?
  datum         DateTime? @db.Date // Datum od
  datum_do      DateTime? @db.Date // DODATO: Datum do (za višednevne obaveze)
  vreme_pocetka DateTime? @db.Time(6) // Sada je opcionalno jer višednevne nemaju satnicu
  vreme_kraja   DateTime? @db.Time(6) // Takođe opcionalno
  tip_obaveze   String?

  saradnik      Profesor  @relation(fields: [saradnik_id], references: [id], onDelete: Cascade)
}
model Dezurstva {
id          Int       @id @default(autoincrement())
ispit_id    Int?
ispit       Ispit?    @relation(fields: [ispit_id], references: [id])
saradnik_id Int?
saradnik    Profesor? @relation(fields: [saradnik_id], references: [id])
}
