generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  username        String    @unique
  email           String    @unique
  password        String
  uloga           String    @default("asistent")
  reset_token     String?
  reset_token_exp DateTime?
}

model Profesor {
  id          Int         @id @default(autoincrement())
  ime         String
  prezime     String
  is_saradnik Boolean     @default(false)
  email       String?
  predmeti    Predmet[]   @relation("GlavniProfesor")
  angazovanja Predmet[]   @relation("AngazovaniSaradnici")
  
  dezurstva   Dezurstva[]
  obaveze     Obaveza[]

  zahteviZamene       ZahtevZamene[] @relation("ZamenaTrazilac")
  predlozeniZaZamenu  ZahtevZamene[] @relation("ZamenaPredlozeni")
}

model Predmet {
  id          Int      @id @default(autoincrement())
  sifra       String   @unique
  naziv       String
  godina      Int
  semestar    String
  status         String     // O ili I
  broj_studenata Int        @default(0) // <--- DODATO
  
  // Glavni profesor
  profesor_id Int?
  profesor    Profesor?  @relation("GlavniProfesor", fields: [profesor_id], references: [id])
  
  // Lista saradnika (asistenata) koji drže vežbe na ovom predmetu
  saradnici   Profesor[] @relation("AngazovaniSaradnici")
  
  ispiti      Ispit[]
  terminiKolokvijuma TerminKolokvijuma?
  grupe       GrupaPredmeta[] @relation("PredmetiUGrupi")

  @@index([profesor_id])
}
model Sala {
  id        Int      @id @default(autoincrement())
  naziv     String   @unique
  kapacitet Int?     
  ispiti    Ispit[]
  redovnaNastava RedovnaNastava[]
}
model Ispit {
  id         Int         @id @default(autoincrement())
  predmet_id Int?
  datum      DateTime
  vreme       DateTime  @db.Time(6)
  vreme_kraja DateTime? @db.Time(6)
  sala_id    Int?
  tip_kolokvijuma String?
  is_ispit   Boolean     @default(true)
  is_izmenjen  Boolean     @default(false)
  predmet    Predmet?    @relation(fields: [predmet_id], references: [id])
  is_published Boolean    @default(false)
  sala       Sala?       @relation(fields: [sala_id], references: [id])
  // Termini nastali jednim prevlacenjem grupe predmeta dele isti kljuc i ponasaju se kao celina
  grupa_kljuc String?
  
  dezurstva  Dezurstva[] 

  @@index([predmet_id])
  @@index([datum])
  @@index([sala_id])
  @@index([is_published])
  @@index([grupa_kljuc])
}
model RedovnaNastava {
  id             Int      @id @default(autoincrement())
  sala_id        Int
  sala           Sala     @relation(fields: [sala_id], references: [id])
  datum          DateTime // <--- Tačan datum nastave iz IMI kalendara!
  vreme_pocetka  String
  vreme_kraja    String
  predmet        String
  nastavnik      String?

  @@index([sala_id, datum])
}
model Obaveza {
  id            Int       @id @default(autoincrement())
  saradnik_id   Int
  dan_u_nedelji Int?
  datum         DateTime? @db.Date // Datum od
  datum_do      DateTime? @db.Date // DODATO: Datum do (za višednevne obaveze)
  vreme_pocetka DateTime? @db.Time(6) // Sada je opcionalno jer višednevne nemaju satnicu
  vreme_kraja   DateTime? @db.Time(6) // Takođe opcionalno
  tip_obaveze   String?

  saradnik      Profesor  @relation(fields: [saradnik_id], references: [id], onDelete: Cascade)

  @@index([saradnik_id])
  @@index([datum])
}
model AuditLog {
  id         Int      @id @default(autoincrement())
  korisnik   String
  akcija     String
  entitet    String
  detalji    String?
  created_at DateTime @default(now())

  @@index([created_at])
}
model Dezurstva {
  id          Int       @id @default(autoincrement())
  ispit_id    Int?
  ispit       Ispit?    @relation(fields: [ispit_id], references: [id], onDelete: Cascade)
  saradnik_id Int?
  saradnik    Profesor? @relation(fields: [saradnik_id], references: [id], onDelete: Cascade)

  zahtevi     ZahtevZamene[]

  @@index([ispit_id])
  @@index([saradnik_id])
}

model TerminKolokvijuma {
  id                      Int      @id @default(autoincrement())
  predmet_id              Int      @unique // Jedan predmet ima jedan zapis sa preferencijama
  predmet                 Predmet  @relation(fields: [predmet_id], references: [id], onDelete: Cascade)

  // Prvi kolokvijum
  k1_datum                String?  // npr. "29.04.2026"
  k1_trajanje             Int?     // u minutama (npr. 90)
  k1_racunarska_sala      Boolean  @default(false)

  // Drugi kolokvijum
  k2_datum                String?
  k2_trajanje             Int?
  k2_racunarska_sala      Boolean  @default(false)

  // Treći kolokvijum
  k3_datum                String?
  k3_trajanje             Int?
  k3_racunarska_sala      Boolean  @default(false)

  // Popravni kolokvijum (opciono)
  popravni_u_terminu_ispita Boolean @default(false)
  popravni_trajanje        Int?
  popravni_racunarska_sala Boolean @default(false)

  // Potreban broj dezurnih po kolokvijumu (unosi saradnik; koristi ga tabela dezurstava)
  k1_dezurni              Int?
  k2_dezurni              Int?
  k3_dezurni              Int?
  popravni_dezurni        Int?

  napomena                String?

  created_at              DateTime @default(now())
  updated_at              DateTime @updatedAt
}

// Zahtev asistenta da bude zamenjen na jednom dežurstvu; odobrava ga administrator
model ZahtevZamene {
  id              Int       @id @default(autoincrement())
  dezurstvo_id    Int
  dezurstvo       Dezurstva @relation(fields: [dezurstvo_id], references: [id], onDelete: Cascade)
  trazilac_id     Int
  trazilac        Profesor  @relation("ZamenaTrazilac", fields: [trazilac_id], references: [id], onDelete: Cascade)
  predlozeni_id   Int?
  predlozeni      Profesor? @relation("ZamenaPredlozeni", fields: [predlozeni_id], references: [id], onDelete: SetNull)
  razlog          String
  status          String    @default("na_cekanju") // na_cekanju | odobren | odbijen | otkazan
  napomena_admina String?
  created_at      DateTime  @default(now())
  resolved_at     DateTime?

  @@index([status])
  @@index([trazilac_id])
  @@index([dezurstvo_id])
}

// Grupa predmeta koji se uvek zakazuju istog dana u isto vreme (npr. apsolventski rokovi)
model GrupaPredmeta {
  id         Int       @id @default(autoincrement())
  naziv      String
  predmeti   Predmet[] @relation("PredmetiUGrupi")
  created_at DateTime  @default(now())
}
