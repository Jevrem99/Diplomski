# Kopiraj u ".env" (pored docker-compose.yml) i popuni. Fajl .env se NE komituje.
# Pokretanje:  docker compose up -d --build

# --- Baza (koristi slova i cifre u lozinci: ulazi u adresu baze) ---
POSTGRES_PASSWORD=
POSTGRES_USER=raspored
POSTGRES_DB=raspored

# --- Adresa aplikacije (kako je korisnici otvaraju u pregledaču; bez kose crte na kraju) ---
FRONTEND_URL=http://localhost:8080
# Podrazumevano isto kao FRONTEND_URL
#CORS_ORIGINS=
# Spoljni port na kome je aplikacija dostupna
HTTP_PORT=8080

# --- Prijava ---
# Generiši: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=12h
# Prvi administrator (pravi se pri prvom pokretanju ako admina nema). Postavi lozinku i promeni je posle prve prijave.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@pmf.kg.ac.rs
ADMIN_PASSWORD=

# --- Mejl (obaveštenja o dežurstvima, reset lozinke); prazno = mejlovi se ne šalju ---
EMAIL_USER=
EMAIL_PASS=

# --- Integracija: ključ kojim sistem fakulteta preuzima rezervacije sala (najmanje 24 znaka; prazno = isključeno) ---
# Generiši: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTEGRACIJA_API_KLJUC=

# --- Prijava preko PMF naloga (ostavi prazno za pravi IMI) ---
# Za probu sa lažnim PMF serverom (u backend folderu: npm run lazni-pmf), odkomentariši:
#PMF_PRIJAVA_URL=http://localhost:5050/cp/
#PMF_VERIFY_URL=http://host.docker.internal:5050/cp/verify_token.php

# --- Noćna sinhronizacija redovne nastave sa IMI sajta ---
NOCNI_SYNC=true
NOCNI_SYNC_SAT=3
