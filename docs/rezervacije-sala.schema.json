{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rezervacije-sala.schema.json",
  "title": "Rezervacije sala za kolokvijume (verzija 1)",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "verzija", "generisano", "objavio", "rezervacije", "bez_sale"],
  "properties": {
    "format": { "type": "string", "const": "raspored-rezervacije-sala" },
    "verzija": { "type": "integer", "const": 1 },
    "generisano": { "type": "string", "description": "Trenutak pravljenja odgovora (ISO 8601, UTC)." },
    "objavio": { "type": ["string", "null"], "description": "Ko je zatražio podatke (kod integracije uvek 'integracija')." },
    "rezervacije": {
      "type": "array",
      "items": { "$ref": "#/definitions/rezervacija" }
    },
    "bez_sale": {
      "type": "array",
      "description": "Objavljeni kolokvijumi kojima sala još nije izabrana: nema šta da se rezerviše.",
      "items": { "$ref": "#/definitions/bezSale" }
    }
  },
  "definitions": {
    "rezervacija": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "izmena", "sala", "datum", "od", "do", "do_pretpostavljen", "namena", "tip", "tip_opis", "racunarska_sala", "predmeti", "ukupno_studenata"],
      "properties": {
        "id": { "type": "string", "pattern": "^kol-[0-9]+$", "description": "Stalan identifikator rezervacije." },
        "izmena": { "type": "boolean", "description": "Termin je posle prethodne objave izmenjen." },
        "sala": { "type": "string", "minLength": 1, "description": "Naziv sale, npr. A-0-15." },
        "datum": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "od": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "do": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "do_pretpostavljen": { "type": "boolean", "description": "Kraj nije unet; uzeto je trajanje od 2 sata." },
        "namena": { "type": "string", "const": "Kolokvijum" },
        "tip": { "type": "string", "description": "Oznaka kako je uneta: I, II, III, test, Поправни I ..." },
        "tip_opis": { "type": "string", "description": "Opis za prikaz, npr. 'I колоквијум'." },
        "racunarska_sala": { "type": "boolean", "description": "Nastavnik je tražio računarsku salu." },
        "predmeti": {
          "type": "array",
          "minItems": 1,
          "description": "Više predmeta u jednoj rezervaciji znači grupu koja se drži istovremeno u istoj sali.",
          "items": { "$ref": "#/definitions/predmet" }
        },
        "ukupno_studenata": { "type": "integer", "minimum": 0 }
      }
    },
    "predmet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sifra", "naziv", "godina", "nosilac", "broj_studenata"],
      "properties": {
        "sifra": { "type": ["string", "null"] },
        "naziv": { "type": "string" },
        "godina": { "type": ["integer", "null"], "description": "Godina studija; 5 = master (MAS)." },
        "nosilac": { "type": ["string", "null"], "description": "Ime i prezime nosioca predmeta." },
        "broj_studenata": { "type": "integer", "minimum": 0 }
      }
    },
    "bezSale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "datum", "od", "naziv"],
      "properties": {
        "id": { "type": "string", "pattern": "^kol-[0-9]+$" },
        "datum": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "od": { "type": ["string", "null"] },
        "naziv": { "type": "string" }
      }
    }
  }
}
